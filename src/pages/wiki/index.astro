---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WikiCard from '../../components/WikiCard.astro';
import { getWikiEntries, groupByCategory, wikiUpdated } from '../../lib/content';

const entries = await getWikiEntries();
const groups = groupByCategory(entries);
---

<BaseLayout
  title="Wiki"
  description="My notes and links on what I am learning."
>
  <div class="container section">
    <div class="section-head">
      <h2>Wiki</h2>
    </div>
    <p class="lead">
      My notes and links on what I am learning live in my
      <a href="https://davd-gzl.github.io/personal-wiki/">personal wiki</a>.
    </p>

    {
      entries.length > 0 ? (
        <div style="margin-top: var(--space-6)">
          {groups.map(([category, items]) => (
            <section class="wiki-group">
              <h2>{category}</h2>
              <ul class="card-grid">
                {items.map((e) => (
                  <WikiCard
                    href={`/wiki/${e.id}`}
                    title={e.data.title}
                    summary={e.data.summary}
                    updated={wikiUpdated(e)}
                    tags={e.data.tags}
                  />
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <div class="empty-state" style="margin-top: var(--space-6)">
          <p style="margin:0"><a href="https://davd-gzl.github.io/personal-wiki/">Open the personal wiki</a></p>
        </div>
      )
    }
  </div>
</BaseLayout>
