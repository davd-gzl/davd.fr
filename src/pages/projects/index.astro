---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/content';

const projects = await getProjects();
---

<BaseLayout
  title="Projects"
  description="What I work on: Gno.land, teaching, Offware, agents and a few other projects."
>
  <div class="container section">
    <div class="section-head">
      <h2>Projects</h2>
    </div>
    <p class="lead">What I work on: Gno.land, teaching, Offware, agents and a few other projects.</p>

    {
      projects.length > 0 ? (
        <ul class="card-grid" style="margin-top: var(--space-6)">
          {projects.map((p) => (
            <ProjectCard
              href={`/projects/${p.id}`}
              title={p.data.title}
              summary={p.data.summary}
              tags={p.data.tags}
              repo={p.data.repo}
              url={p.data.url}
              featured={p.data.featured}
              line={p.data.line}
            />
          ))}
        </ul>
      ) : (
        <div class="empty-state" style="margin-top: var(--space-6)">
          <p style="margin:0">No projects published yet.</p>
        </div>
      )
    }
  </div>
</BaseLayout>
