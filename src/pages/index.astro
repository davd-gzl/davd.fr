---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MetroMap from '../components/MetroMap.astro';
import NetworkBackground from '../components/NetworkBackground.astro';
import { site, lines } from '../config/site';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const groups = lines
  .map((l) => ({ line: l, items: projects.filter((p) => p.data.line === l.id) }))
  .filter((g) => g.items.length > 0);
---

<BaseLayout>
  <NetworkBackground />

  <section class="container hero">
    <h1>Hi, I'm {site.firstName}.</h1>
    <p class="hero-links">
      {site.socials.map((s, i) => (
        <Fragment>
          {i > 0 && <span class="sep" aria-hidden="true">·</span>}
          <a
            href={s.href}
            rel={s.href.startsWith('http') ? 'me noopener' : undefined}
            target={s.href.startsWith('http') ? '_blank' : undefined}
          >
            {s.label}
          </a>
        </Fragment>
      ))}
    </p>
  </section>

  <section class="container section map-section" aria-label="Map of my projects">
    <MetroMap />
  </section>

  {groups.map((g) => (
    <section class="container section line-group" style={`--c:${g.line.color}`} id={g.line.id}>
      <h2><span class="roundel" aria-hidden="true">{g.line.code}</span>{g.line.name}</h2>
      <p class="line-blurb">{g.line.blurb}</p>
      <ul class="card-grid">
        {g.items.map((p) => (
          <ProjectCard
            href={`/projects/${p.id}`}
            title={p.data.title}
            summary={p.data.summary}
            tags={p.data.tags}
            repo={p.data.repo}
            url={p.data.url}
            line={p.data.line}
          />
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
