---
// A project card, edged in the colour of its theme.
import { lines } from '../config/site';

interface Props {
  href: string;
  title: string;
  summary: string;
  tags?: string[];
  repo?: string;
  url?: string;
  featured?: boolean;
  line?: string;
}

const { href, title, summary, tags = [], repo, url, line } = Astro.props;
const l = lines.find((x) => x.id === line);
---

<li class="card project-card" style={`--c:${l?.color ?? 'var(--text-muted)'}`}>
  <p class="card-kind"><span class="kind-dot" aria-hidden="true"></span>{l?.name ?? 'Other'}</p>
  <h3><a href={href}>{title}</a></h3>
  <p class="card-summary">{summary}</p>
  {
    tags.length > 0 && (
      <ul class="tags">
        {tags.map((t) => <li class="tag">{t}</li>)}
      </ul>
    )
  }
  <div class="card-links">
    <a href={href}>Details →</a>
    {url && <a href={url} target="_blank" rel="noopener">Live ↗</a>}
    {repo && <a href={repo} target="_blank" rel="noopener">Code ↗</a>}
  </div>
</li>
