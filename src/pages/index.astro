---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MetroMap from '../components/MetroMap.astro';
import Journey from '../components/Journey.astro';
import NetworkBackground from '../components/NetworkBackground.astro';
import { site, now, interests } from '../config/site';
import { getProjects } from '../lib/content';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured).slice(0, 6);

/** "a, b and c", keeping each item as written. */
const join = (items: readonly string[]) =>
  items.length > 1 ? `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}` : items[0];
---

<BaseLayout>
  <NetworkBackground />

  <section class="container hero">
    <h1>Hi, I'm {site.firstName}.</h1>
    <div class="bio">
      {site.bio.map((para) => <p>{para}</p>)}
    </div>
    <p class="hero-links">
      {site.socials.map((s, i) => (
        <Fragment>
          {i > 0 && <span class="sep" aria-hidden="true">·</span>}
          <a
            href={s.href}
            rel={s.href.startsWith('http') ? 'me noopener' : undefined}
            target={s.href.startsWith('http') ? '_blank' : undefined}
          >
            {s.label}
          </a>
        </Fragment>
      ))}
    </p>
  </section>

  <section class="container section map-section" aria-label="Map of my work">
    <MetroMap />
  </section>

  <section class="container section" aria-labelledby="now-title">
    <h2 id="now-title">Now</h2>
    <ul class="now">
      {now.map((n) => (
        <li>
          <span class="now-value">{n.value}</span>
          <span class="now-label">{n.label}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container section" id="experience">
    <h2>Experience</h2>
    <Journey />
  </section>

  <section class="container section">
    <div class="section-head">
      <h2>Projects</h2>
      <a href="/projects">See all</a>
    </div>
    <ul class="card-grid">
      {featured.map((p) => (
        <ProjectCard
          href={`/projects/${p.id}`}
          title={p.data.title}
          summary={p.data.summary}
          tags={p.data.tags}
          repo={p.data.repo}
          url={p.data.url}
          line={p.data.line}
        />
      ))}
    </ul>
  </section>

  <section class="container section likes" aria-labelledby="likes-title">
    <h2 id="likes-title">What I like</h2>
    <p>
      In code: {join(interests.code)}. Outside of it: {join(interests.life)}.
    </p>
    <p>
      I'm a curious person who wants to contribute to the greater good, and I'm
      open to contributing to new projects.
    </p>
  </section>
</BaseLayout>
