---
import { site } from '../config/site';

const year = new Date().getFullYear();

// Inline icon paths (24x24). Kept tiny; no icon library dependency.
const icons: Record<string, string> = {
  github:
    'M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.38-3.37-1.38-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.48-.01 2.82 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z',
  email:
    'M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm0 2v.4l8 5 8-5V6H4zm16 2.5-7.4 4.62a1 1 0 0 1-1.2 0L4 8.5V18h16V8.5z',
  link: 'M10.59 13.41a1 1 0 0 1 0-1.41l3-3a3 3 0 1 1 4.24 4.24l-1.5 1.5a1 1 0 0 1-1.42-1.42l1.5-1.5a1 1 0 1 0-1.4-1.4l-3 3a1 1 0 0 1-1.42 0zm2.82-2.82a1 1 0 0 1 0 1.41l-3 3a3 3 0 1 1-4.24-4.24l1.5-1.5a1 1 0 1 1 1.42 1.42l-1.5 1.5a1 1 0 1 0 1.4 1.4l3-3a1 1 0 0 1 1.42 0z',
};
---

<footer class="site-footer">
  <div class="container">
    <p style="margin:0">
      © {year} {site.name}{site.location ? ` · ${site.location}` : ''} ·
      <span style="font-family:var(--font-mono)">{site.shortName}.fr</span> ·
      <a href="/rss.xml">RSS</a>
    </p>
    <ul class="social-links">
      {
        site.socials.map((s) => (
          <li>
            <a
              href={s.href}
              rel={s.href.startsWith('http') ? 'me noopener' : undefined}
              target={s.href.startsWith('http') ? '_blank' : undefined}
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d={icons[s.icon] ?? icons.link} />
              </svg>
              <span>{s.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
