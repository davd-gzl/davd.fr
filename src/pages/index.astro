---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetroMap from '../components/MetroMap.astro';
import Timetable from '../components/Timetable.astro';
import NetworkBackground from '../components/NetworkBackground.astro';
import { site } from '../config/site';
---

<BaseLayout>
  <NetworkBackground />

  <section class="container hero">
    <div class="panel hero-card">
    <h1>{site.name}</h1>
    <p class="hero-links">
      {site.socials.map((s, i) => (
        <Fragment>
          {i > 0 && <span class="sep" aria-hidden="true">/</span>}
          <a
            href={s.href}
            rel={s.href.startsWith('http') ? 'me noopener' : undefined}
            target={s.href.startsWith('http') ? '_blank' : undefined}
          >
            {s.label}
          </a>
        </Fragment>
      ))}
    </p>
    </div>
  </section>

  <section class="container map-section" aria-label="Map of my projects">
    <MetroMap />
  </section>

  <section class="container section">
    <Timetable />
  </section>
</BaseLayout>
