---
// Every project as a station on a metro map. Each theme is a line leaving the
// same hub, and its projects sit evenly along it, so a new Markdown file adds a
// station with no change here.
import { lines } from '../config/site';
import { getProjects } from '../lib/content';

type Pt = [number, number];

const hub: Pt = [450, 260];

// Each line leaves the hub with one short bend, then runs straight; its
// stations spread along that straight run, where labels have room.
const tracks: Record<string, string> = {
  gno: 'M450 260 L510 200 H900',
  offware: 'M450 260 L520 330 H900',
  teach: 'M450 260 L390 200 H20',
  side: 'M450 260 L380 330 H20',
  agents: 'M450 260 V150 L480 120 V10',
};

/** The corner points of a track written with M, H, V and L only. */
function corners(d: string): Pt[] {
  const pts: Pt[] = [];
  let [x, y] = [0, 0];
  for (const [, op, args] of d.matchAll(/([MHVL])([^MHVL]*)/g)) {
    const n = args.trim().split(/[\s,]+/).map(Number);
    if (op === 'H') x = n[0];
    else if (op === 'V') y = n[0];
    else [x, y] = n;
    pts.push([x, y]);
  }
  return pts;
}

const projects = await getProjects();

const routes = lines.map((l) => {
  const d = tracks[l.id];
  const mine = projects.filter((p) => p.data.line === l.id);
  const pts = corners(d);
  const [a, b] = pts.slice(-2);
  const horizontal = a[1] === b[1];
  const stations = mine.map((p, i) => {
    // Evenly along the straight run, clear of the bend at its start.
    const t = ((i + 0.6) / mine.length) * 0.92;
    const x = a[0] + (b[0] - a[0]) * t;
    const y = a[1] + (b[1] - a[1]) * t;
    // Labels alternate sides of the track, so neighbours never touch.
    const up = i % 2 === 0;
    const label = horizontal
      ? { x, y: y + (up ? -20 : 32), anchor: 'middle' }
      : { x: x + (up ? 18 : -18), y: y + 6, anchor: up ? 'start' : 'end' };
    return { id: p.id, title: p.data.title, summary: p.data.summary, x, y, label };
  });
  return { line: l, d, stations };
});
---

<figure class="metro">
  <svg viewBox="0 0 920 380" role="img" aria-labelledby="metro-title" class="metro-svg">
    <title id="metro-title">
      A metro map of my projects: one line per theme, one station per project.
    </title>

    <g class="metro-grid" aria-hidden="true">
      {Array.from({ length: 12 }, (_, i) => (
        <line x1={i * 80 + 20} y1="0" x2={i * 80 + 20} y2="380" />
      ))}
      {Array.from({ length: 5 }, (_, i) => (
        <line x1="0" y1={i * 80 + 20} x2="920" y2={i * 80 + 20} />
      ))}
    </g>

    {routes.map((r) => (
      <g class={`route route-${r.line.id}`} style={`--c:${r.line.color}`}>
        <path class="route-casing" d={r.d} />
        <path class="route-path" d={r.d} id={`path-${r.line.id}`} />
        <circle class="train" r="6">
          <animateMotion dur="12s" repeatCount="indefinite" rotate="auto">
            <mpath href={`#path-${r.line.id}`} />
          </animateMotion>
        </circle>
      </g>
    ))}

    {routes.map((r) =>
      r.stations.map((s) => (
        <a
          href={`/projects/${s.id}`}
          class="station"
          style={`--c:${r.line.color}`}
          data-title={s.title}
          data-summary={s.summary}
          data-line={r.line.name}
        >
          <title>{s.title}: {s.summary}</title>
          <circle cx={s.x} cy={s.y} r="9" />
          <text class="map-label" x={s.label.x} y={s.label.y} text-anchor={s.label.anchor}>
            {s.title}
          </text>
        </a>
      ))
    )}

    <g class="hub" aria-hidden="true">
      <rect x={hub[0] - 34} y={hub[1] - 22} width="68" height="44" rx="22" />
      <text x={hub[0]} y={hub[1] + 6} text-anchor="middle">davd</text>
    </g>
  </svg>

  <figcaption class="map-panel" data-panel aria-live="polite">
    <p class="map-panel-line" data-panel-line>{projects.length} projects on {lines.length} lines</p>
    <p class="map-panel-title" data-panel-title>Pick a station to see the project.</p>
    <p class="map-panel-summary" data-panel-summary></p>
  </figcaption>
</figure>

<script is:inline>
  (function () {
    var panel = document.querySelector('[data-panel]');
    if (!panel) return;
    var line = panel.querySelector('[data-panel-line]');
    var title = panel.querySelector('[data-panel-title]');
    var summary = panel.querySelector('[data-panel-summary]');
    function show(st) {
      panel.style.setProperty('--c', st.style.getPropertyValue('--c'));
      line.textContent = st.dataset.line;
      title.textContent = st.dataset.title;
      summary.textContent = st.dataset.summary;
    }
    document.querySelectorAll('.station').forEach(function (st) {
      st.addEventListener('mouseenter', function () { show(st); });
      st.addEventListener('focus', function () { show(st); });
    });
  })();
</script>
