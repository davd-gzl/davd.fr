---
import { render } from 'astro:content';
import ProseLayout from '../../layouts/ProseLayout.astro';
import { getProjects } from '../../lib/content';
import { lines } from '../../config/site';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, tags, repo, url, date } = entry.data;
const dateLabel = date ? date.toISOString().slice(0, 10) : undefined;
const line = lines.find((l) => l.id === entry.data.line);
---

<ProseLayout title={title} description={summary} backHref="/" backLabel="All projects">
  <div slot="meta" class="project-meta" style={`--c:${line?.color ?? 'var(--text-muted)'}`}>
    <p class="lead">{summary}</p>
    <p class="project-facts">
      {line && <span class="project-line">{line.name}</span>}
      {dateLabel && <time datetime={dateLabel}>{dateLabel}</time>}
      {tags.length > 0 && <span>{tags.join(' · ')}</span>}
    </p>
    {
      (repo || url) && (
        <p class="stop-links">
          {url && <a class="open" href={url} target="_blank" rel="noopener">open {title} ↗</a>}
          {repo && <a href={repo} target="_blank" rel="noopener">code ↗</a>}
        </p>
      )
    }
  </div>

  <Content />
</ProseLayout>
